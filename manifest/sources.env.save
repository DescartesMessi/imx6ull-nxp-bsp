# NXP official sources
NXP_UBOOT_URL="https://github.com/nxp-imx/uboot-imx.git"
NXP_LINUX_URL="https://github.com/nxp-imx/linux-imx.git"

# Matched NXP BSP baseline. bootstrap_sources.sh verifies these refs remotely.
NXP_UBOOT_REF="rel_imx_4.1.15_2.1.0_ga"
NXP_LINUX_REF="rel_imx_4.1.15_2.1.0_ga"

# Official EVK starting points. Board-specific support will be added on custom branches.
UBOOT_DEFCONFIG="mx6ull_14x14_evk_emmc_defconfig"
LINUX_DEFCONFIG="imx_v7_defconfig"
LINUX_DTB="imx6ull-14x14-evk.dtb"

# Host toolchain
ARCH="arm"
CROSS_COMPILE="arm-linux-gnueabihf-"
JOBS="8"

# Local deployment paths
TFTP_DIR="/home/pointer/linux/tftpboot"
NFS_ROOT="/home/pointer/linux/nfs/rootfs-jjl"
