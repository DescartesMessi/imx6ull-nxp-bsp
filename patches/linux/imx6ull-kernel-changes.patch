@@ -12,6 +12,7 @@
 #include <linux/string.h>
 #include <linux/uaccess.h>
 #include <linux/delay.h>
+#include <linux/jiffies.h>
 #include <linux/smarthome_dht11.h>
 
 #define DHT11_DEVICE_NAME "dht11"
@@ -24,6 +25,13 @@
 #define DHT11_DATA_BITS 40
 #define DHT11_DATA_BYTES 5
 
+/*
+ * DHT11 数据手册要求采样间隔不小于 1 秒。
+ * 读得太快不会报错，而是重复返回上一次的旧值，属于“看起来正常但不正确”的失效，
+ * 因此驱动层必须自己守住这个约束。
+ */
+#define DHT11_MIN_INTERVAL_MS 1000
+
 struct dht11_device {
     dev_t devt;
     struct cdev cdev;
@@ -31,6 +39,7 @@ struct dht11_device {
     struct device *device;
     struct gpio_desc *data_gpio;
     struct mutex lock;
+    unsigned long last_read;   /* 上次成功采样的 jiffies，用于限制采样频率 */
 };
 
 static int dht11_wait_level(struct dht11_device *dev,
@@ -110,9 +119,15 @@ static int dht11_read_frame(struct dht11_device *dev, u8 data[5])
         return ret;
 
     /*
-     * DHT11 的时序窗口很短。
-     * 锁住当前进程，避免同一个设备被并发访问。
-     * 不在这里关闭全局中断，避免影响系统其他设备。
+     * DHT11 一位数据的周期只有 26~70us，采样点在上升沿后 40us，
+     * 容差约 ±13us，任何一次中断处理都可能把这次采样带偏，
+     * 因此整帧读取期间必须关闭本地中断。
+     *
+     * 这里用 local_irq_save 而不是 local_irq_disable：
+     *  - 只关当前 CPU 的中断，SMP 下其他核不受影响；
+     *  - 保存并恢复中断状态，避免破坏调用者的上下文。
+     * 代价是约 2.8~4ms 的中断延迟，属于单总线器件必须付出的代价，
+     * 并发访问由上层 mutex（dev->lock）串行化。
      */
     local_irq_save(flags);
 
@@ -155,15 +170,38 @@ static int dht11_measure(struct dht11_device *dev,
     u8 checksum;
     int ret;
 
+    /*
+     * 补足采样间隔：DHT11 读太快只会返回旧值，所以这里主动睡眠到满足
+     * 1 秒间隔再采样，保证每次返回的都是新数据，同时保持 read/ioctl 接口不变。
+     */
+    if (dev->last_read &&
+        time_before(jiffies, dev->last_read + msecs_to_jiffies(DHT11_MIN_INTERVAL_MS))) {
+        unsigned long delay =
+            dev->last_read + msecs_to_jiffies(DHT11_MIN_INTERVAL_MS) - jiffies;
+
+        if (msleep_interruptible(jiffies_to_msecs(delay)))
+            return -ERESTARTSYS;
+    }
+
     ret = dht11_read_frame(dev, data);
     if (ret)
         return ret;
 
+    dev->last_read = jiffies;
+
     checksum = data[0] + data[1] + data[2] + data[3];
 
     if (checksum != data[4])
         return -EBADMSG;
 
+    /*
+     * 全 0 帧（5 个字节都是 0）会让校验和“0 == 0”通过，是 DHT11
+     * 无响应或时序失败时最容易出现的假有效数据。DHT11 的湿度量程是
+     * 20~90%RH，0%RH 物理上不可能出现，据此判定为无效更可靠。
+     */
+    if (!(data[0] | data[1] | data[2] | data[3] | data[4]))
+        return -EIO;
+
     memset(measurement, 0, sizeof(*measurement));
 
     measurement->humidity_integer = data[0];
@@ -393,4 +431,4 @@ module_platform_driver(dht11_driver);
 
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("smarthome");
-MODULE_DESCRIPTION("DHT11 temperature and humidity driver");
\ No newline at end of file
+MODULE_DESCRIPTION("DHT11 temperature and humidity driver");
